  m_Script: {fileID: 11500000, guid: 77b469ace0f342940ac15a52b8e53f14, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _Dialog:
  - 'Welcome to Chewinggum-Delivery! I''ve heard that you signed up for this dangerous
    job. My name is Gumer Gumering Gumerton but you can call me Gum. I''ve quit this
    job because it''s too hard - now you need to replace me. So let''s get started! '
  - 'You already have the equipment: A box of never ending chewinggums! If you somehow
    do run out of chewinggums, then come to me.

    Your goal is to feed all pedestrians
    with chewinggums. You have to throw chewinggums with left-click at their heads.
    If you miss, they''ll fall to the ground unconscious...  Watch out, it''s harder
    than you think!'
  _OkButton: {fileID: 2023952756}
  _Gum: {fileID: 350883392}
